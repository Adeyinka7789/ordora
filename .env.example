# ---- Server ----
ORDORA_ENV=development
ORDORA_HTTP_ADDR=:8080
ORDORA_BASE_URL=http://localhost:8080

# ---- Database ----
ORDORA_DB_HOST=localhost
ORDORA_DB_PORT=5432
ORDORA_DB_NAME=ordora_dev
ORDORA_DB_USER=ordora_app
ORDORA_DB_PASSWORD=change_me_in_local_env
ORDORA_DB_SSLMODE=disable

# Admin credentials used only by the migration runner
ORDORA_DB_ADMIN_USER=postgres
ORDORA_DB_ADMIN_PASSWORD=change_me_in_local_env

# ---- Sessions ----
ORDORA_SESSION_COOKIE_NAME=ordora_session
ORDORA_SESSION_TTL_HOURS=720
ORDORA_CSRF_COOKIE_NAME=ordora_csrf

# ---- Email (dev: log to console) ----
ORDORA_EMAIL_MODE=console
ORDORA_EMAIL_FROM=no-reply@ordora.local

# ---- Storage (dev: local disk) ----
ORDORA_STORAGE_MODE=local
ORDORA_STORAGE_LOCAL_DIR=./uploads