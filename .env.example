# ---- Server ----
ORDORA_ENV=development
ORDORA_HTTP_ADDR=:8080
ORDORA_BASE_URL=http://localhost:8080

# ---- Database ----
ORDORA_DB_HOST=localhost
ORDORA_DB_PORT=5432
ORDORA_DB_NAME=ordora_dev
ORDORA_DB_USER=ordora_app
ORDORA_DB_PASSWORD=Omowunmi77897789*
ORDORA_DB_SSLMODE=disable

# Admin credentials used only by the migration runner
ORDORA_DB_ADMIN_USER=postgres
ORDORA_DB_ADMIN_PASSWORD=Omowunmi77897789*

# ---- Sessions ----
ORDORA_SESSION_COOKIE_NAME=ordora_session
ORDORA_SESSION_TTL_HOURS=720
# Absolute idle cap: sessions idle longer than this are rejected.
# 0 disables idle enforcement (absolute TTL still applies).
ORDORA_SESSION_IDLE_HOURS=168
ORDORA_CSRF_COOKIE_NAME=ordora_csrf

# ---- Email ----
# Mode: "console" (dev — logs to stdout) or "smtp" (production)
ORDORA_EMAIL_MODE=console
ORDORA_EMAIL_FROM=no-reply@ordora.local

# SMTP settings — only used when ORDORA_EMAIL_MODE=smtp
# Local relay on the VPS: host=localhost port=25, no auth
# External relay: host, port 587, username + password
ORDORA_SMTP_HOST=
ORDORA_SMTP_PORT=587
ORDORA_SMTP_USERNAME=
ORDORA_SMTP_PASSWORD=
ORDORA_SMTP_IMPLICIT_TLS=false

# ---- Storage (dev: local disk) ----
ORDORA_STORAGE_MODE=local
ORDORA_STORAGE_LOCAL_DIR=./uploads

# ---- Support ----
# Shown in the app footer; complaints can be sent here or via /support.
ORDORA_SUPPORT_EMAIL=support@ordora.local

# ---- Public contact details (editable file) ----
# Utility top bar + floating WhatsApp button (landing page + app) read from
# this JSON file. Edit contact.json any time — changes apply on restart.
# Missing file = details hidden. Invalid JSON = startup error.
ORDORA_CONTACT_FILE=contact.json

# ---- Error monitoring (Sentry) ----
# Empty DSN = disabled (local dev default). On the VPS, set this to your
# Sentry DSN (Project Settings > Client Keys (DSN)). Never commit the real
# key — keep it in .env / server environment only.
ORDORA_SENTRY_DSN=
ORDORA_SENTRY_ENVIRONMENT=development
# 0 = no tracing data sent (default). 1.0 = capture every request.
# Keep low (e.g. 0.1) in production — full tracing is high-volume.
ORDORA_SENTRY_TRACES_SAMPLE_RATE=0
# Forward slog Warn/Error records to Sentry Logs (stdout logging unchanged).
ORDORA_SENTRY_ENABLE_LOGS=true
# One-shot "It works!" ping at startup. Unset after verifying — every boot
# with this on sends an Issue.
#ORDORA_SENTRY_VERIFY=1


# ---- Admin panel ----
# Set this to a long, random, non-guessable path. Change it periodically.
# Must start with a slash and contain no spaces.
ORDORA_ADMIN_PATH=/ops-x9k2m
ORDORA_ADMIN_SESSION_COOKIE=ordora_admin_session
ORDORA_ADMIN_SESSION_TTL_HOURS=8
