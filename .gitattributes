# Normalize all line endings to LF in the repository,
# regardless of the local OS. Windows checkouts may still
# see CRLF in the working tree if the user prefers, but the
# canonical form committed to Git is always LF.
* text=auto eol=lf

# Binary files — never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary

# Go files specifically — always LF, always text.
*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.sql   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.md    text eol=lf
